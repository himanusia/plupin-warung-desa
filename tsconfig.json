{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node", "bun"],
    "paths": {
      "@plupin/character": ["../../packages/character/src/index.ts"],
      "@plupin/character/*": ["../../packages/character/src/*.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
